# Turso / libSQL
DATABASE_URL=libsql://your-database.turso.io
DATABASE_AUTH_TOKEN=your-turso-auth-token

# Better Auth
# Generate a long random value and never commit the real secret.
BETTER_AUTH_SECRET=replace-with-a-long-random-secret

# Public application origin used by Better Auth/CORS.
# For local development:
WEBSITE_URL=http://localhost:4200

# Optional fallback origin used by hosted environments.
REMOTE_URL=

# Production server port (hosting platforms usually inject this automatically).
PORT=3000
